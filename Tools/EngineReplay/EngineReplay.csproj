<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TModLoaderRoot>$(HOME)/Library/Application Support/Steam/steamapps/common/tModLoader</TModLoaderRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Companion/Brain/SharedMovementSystem/**/*.cs" Exclude="../../Companion/Brain/SharedMovementSystem/TerrariaIntegration/ApplyControlsToCompanion.cs" />
    <Compile Include="../../Companion/Brain/ProjectileAiming/**/*.cs" />
    <Compile Include="../../Companion/Brain/WorldObservation/PredictObservedMotion.cs" />
    <Compile Include="../../Companion/Brain/WorldObservation/CalculateRegroupUrgency.cs" />
    <Compile Include="../../Companion/Brain/BehaviourDiagnostics/RecordGodsEyeEvents.cs" />
    <Compile Include="../../Companion/Brain/BehaviourDiagnostics/ObserveNativeCombatEvents.cs" />
    <Compile Include="../../Companion/Brain/BehaviourDiagnostics/ObserveTerrainChanges.cs" />
    <Compile Include="../../Companion/Brain/BehaviourWeights.cs" />
    <Compile Include="../../Companion/PlayerIntegration/ObservePlayerEvents.cs" />
    <Reference Include="tModLoader"><HintPath>$(TModLoaderRoot)/tModLoader.dll</HintPath></Reference>
    <Reference Include="FNA"><HintPath>$(TModLoaderRoot)/Libraries/FNA/1.0.0/FNA.dll</HintPath></Reference>
    <Reference Include="ReLogic"><HintPath>$(TModLoaderRoot)/Libraries/ReLogic/1.0.0/ReLogic.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(TModLoaderRoot)/Libraries/log4net/2.0.8.0/log4net.dll</HintPath></Reference>
  </ItemGroup>
</Project>
