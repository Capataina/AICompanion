<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TModLoaderRoot>$(HOME)/Library/Application Support/Steam/steamapps/common/tModLoader</TModLoaderRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../AICompanion.csproj" Aliases="live" AdditionalProperties="BuildMod=false" />
    <Compile Include="../../Companion/Brain/Infrastructure/Movement/**/*.cs" Exclude="../../Companion/Brain/Infrastructure/Movement/TerrariaIntegration/ApplyControlsToCompanion.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/PredictObservedMotion.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/ObserveThreats.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/WeighThreatUrgency.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/EstimateEffectiveDamage.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/ObserveHostileAttackSources.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/ThreatRecord.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/LineOfSight.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/CalculateRegroupUrgency.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/RecordGodsEyeEvents.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Interactions/ObserveTileToolEffect.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/ObserveNativeCombatEvents.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/ObserveTerrainChanges.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Selection/BehaviourWeights.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Selection/Computation/AllocateDecisionWork.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/CollectNativeEffectReceipts.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/CaptureDecisionSnapshot.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/RecordCourseTrace.cs" />
    <!-- RecordCourseTrace calls the decision audit, so the audit is on this list too. It takes its
         census and its target facts through a delegate precisely so that following it here does not
         drag Selection/ and Activities/ across the boundary; ReadLiveCourseForAudit, which does name
         them, stays on the mod side and is not compiled here. The consequence is a coverage limit
         worth knowing before trusting a green run: the audit's live source is installed by a file this
         project cannot see, so no row here can establish that the install happens. The capture's
         closing line carries `audit-observations-read` for that, and SessionReport grades it. -->
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/AuditDecisionContracts.cs" />
    <!-- The audit's overrun ceiling reads the tick's allowance through its seam, so the seam comes with it. -->
    <Compile Include="../../Companion/Brain/Infrastructure/Selection/Computation/OverrideTickAllowance.cs" />
    <!-- The audit's per-kind fact bound asks the census how many sites a window can hold, so the ranking
         comes with it; a name this project compiles twice must be in both copies or the second one
         silently keeps the previous binary. The placer's own file is deliberately *not* here — it
         reaches the tile watcher and pulls half the mod in behind it, which is why the audit mirrors the
         spacing constant and a row asserts the two still agree. -->
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/RankCensusSitesByWorth.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/QueueDiagnosticRecords.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/FlushDiagnosticRecords.cs" />
    <!-- The section profiler, because the movement core compiled above opens its sections. This copy's
         statics are the second of two; the live brain writes the live:: one, and ResetProcessState resets both. -->
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/ProfileBrainSections.cs" />
    <Compile Include="../../Companion/PlayerIntegration/ObservePlayerEvents.cs" />
    <!-- The ledger's row writer, as a source file: every case here reports through it and through
         nothing else, so the suite's verdicts survive the process that produced them. -->
    <Compile Include="../Ledger/EmitLedgerRows.cs" />
    <Compile Include="../Ledger/ExitWithoutACrashReport.cs" />
    <Reference Include="tModLoader"><HintPath>$(TModLoaderRoot)/tModLoader.dll</HintPath></Reference>
    <!-- The generated On_ detours live here rather than in tModLoader.dll, and the mod build picks the
         whole Libraries tree up while this project names each assembly. TrackTerrainChanges is one of the
         sources compiled a second time above, and it detours the game's door helpers. -->
    <Reference Include="TerrariaHooks"><HintPath>$(TModLoaderRoot)/Libraries/TerrariaHooks/0.0.0.0/TerrariaHooks.dll</HintPath></Reference>
    <Reference Include="FNA"><HintPath>$(TModLoaderRoot)/Libraries/FNA/1.0.0/FNA.dll</HintPath></Reference>
    <Reference Include="ReLogic"><HintPath>$(TModLoaderRoot)/Libraries/ReLogic/1.0.0/ReLogic.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(TModLoaderRoot)/Libraries/log4net/2.0.8.0/log4net.dll</HintPath></Reference>
  </ItemGroup>
</Project>
