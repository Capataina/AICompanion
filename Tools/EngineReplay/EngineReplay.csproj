<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TModLoaderRoot>$(HOME)/Library/Application Support/Steam/steamapps/common/tModLoader</TModLoaderRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../AICompanion.csproj" Aliases="live" AdditionalProperties="BuildMod=false" />
    <Compile Include="../../Companion/Brain/Infrastructure/Movement/**/*.cs" Exclude="../../Companion/Brain/Infrastructure/Movement/TerrariaIntegration/ApplyControlsToCompanion.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Aiming/**/*.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/PredictObservedMotion.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/ObserveThreats.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/EstimateEffectiveDamage.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/ObserveHostileAttackSources.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/ThreatRecord.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/LineOfSight.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Observation/CalculateRegroupUrgency.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/RecordGodsEyeEvents.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Interactions/ObserveTileToolEffect.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/ObserveNativeCombatEvents.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Diagnostics/ObserveTerrainChanges.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Selection/BehaviourWeights.cs" />
    <Compile Include="../../Companion/PlayerIntegration/ObservePlayerEvents.cs" />
    <!-- The ledger's row writer, as a source file: every case here reports through it and through
         nothing else, so the suite's verdicts survive the process that produced them. -->
    <Compile Include="../Ledger/EmitLedgerRows.cs" />
    <Reference Include="tModLoader"><HintPath>$(TModLoaderRoot)/tModLoader.dll</HintPath></Reference>
    <Reference Include="FNA"><HintPath>$(TModLoaderRoot)/Libraries/FNA/1.0.0/FNA.dll</HintPath></Reference>
    <Reference Include="ReLogic"><HintPath>$(TModLoaderRoot)/Libraries/ReLogic/1.0.0/ReLogic.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(TModLoaderRoot)/Libraries/log4net/2.0.8.0/log4net.dll</HintPath></Reference>
  </ItemGroup>
</Project>
