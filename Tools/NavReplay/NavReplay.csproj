<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The game-free side of the movement core: the corner graph, the flood, the route search, the
    smoother and the steering law compiled straight out of the mod tree, so there is one search
    and not a copy, referencing FNA only for Point, Rectangle and Vector2.
    Run from the repository root:  dotnet run - -project Tools/NavReplay - - - -self-test
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AICompanion.Tools.NavReplay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TModLoaderRoot>$(HOME)/Library/Application Support/Steam/steamapps/common/tModLoader</TModLoaderRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Listed one by one because EnableDefaultCompileItems is off above: a source added to this
         folder and not added here does not fail, it is simply absent, and the modes it carries
         report nothing. -->
    <Compile Include="ReadScenarioBlocks.cs" />
    <Compile Include="MirrorScenarioWorlds.cs" />
    <Compile Include="ExtractScenarioFromCapture.cs" />
    <Compile Include="VerifyMirrorExactness.cs" />
    <Compile Include="VerifyCorridorMiddle.cs" />
    <Compile Include="VerifyArrivalHolds.cs" />
    <Compile Include="VerifyAnchorsAndEvade.cs" />
    <Compile Include="VerifyEvadeKeepsTheJob.cs" />
    <Compile Include="VerifyEvadeBendsAccompanying.cs" />
    <Compile Include="VerifyNavigatorKeepsMoving.cs" />
    <Compile Include="VerifyNavigatorConclusions.cs" />
    <!-- The ledger's row writer, as a source file. It names no game type, so including it here
         does not cross the navigation boundary this project exists on the game-free side of. -->
    <Compile Include="../Ledger/EmitLedgerRows.cs" />
    <!--
      The whole navigation tree, by pattern rather than file by file, with the one file that
      names the game excluded. Listing them by hand meant a new file in the core compiled into
      the mod and not into this tool, and since the mod's own build globs its sources that
      failure surfaces only when someone runs the replay: ReactiveWalk.cs landed on 2026-09-09
      and the corpus run was the thing that noticed. The pattern is safe because the tree is
      game-free by construction — Tools/check-navigation-boundary.sh enforces exactly this same
      single exception, so the two agree on what the boundary is.
    -->
    <Compile Include="../../Companion/Brain/Infrastructure/Movement/**/*.cs"
             Exclude="../../Companion/Brain/Infrastructure/Movement/TerrariaIntegration/**/*.cs" />
    <Compile Include="../../Companion/Brain/Infrastructure/Selection/BehaviourWeights.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FNA">
      <HintPath>$(TModLoaderRoot)/Libraries/FNA/1.0.0/FNA.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
