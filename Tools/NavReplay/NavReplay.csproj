<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The replay tool: runs the mod's real navigation core on a text scenario with no game
    running. It compiles the core files straight out of the mod tree, so there is one
    planner, not a copy, and references FNA only for Point, Rectangle and Vector2.
    Run from the repository root:  dotnet run - -project Tools/NavReplay - - Telemetry/Scenarios/*.txt
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AICompanion.Tools.NavReplay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TModLoaderRoot>$(HOME)/Library/Application Support/Steam/steamapps/common/tModLoader</TModLoaderRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="VerifyMovementContracts.cs" />
    <!--
      The whole navigation tree, by pattern rather than file by file, with the one file that
      names the game excluded. Listing them by hand meant a new file in the core compiled into
      the mod and not into this tool, and since the mod's own build globs its sources that
      failure surfaces only when someone runs the replay: ReactiveWalk.cs landed on 2026-09-09
      and the corpus run was the thing that noticed. The pattern is safe because the tree is
      game-free by construction — Tools/check-navigation-boundary.sh enforces exactly this same
      single exception, so the two agree on what the boundary is.
    -->
    <Compile Include="../../Companion/Brain/SharedMovementSystem/**/*.cs"
             Exclude="../../Companion/Brain/SharedMovementSystem/TerrariaIntegration/**/*.cs" />
    <Compile Include="../../Companion/Brain/BehaviourWeights.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FNA">
      <HintPath>$(TModLoaderRoot)/Libraries/FNA/1.0.0/FNA.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
