# Build output
bin/
obj/
*.tmod

# Per-session brain telemetry written by the mod at run time (Brain/Debug/BrainTelemetry.cs)
Telemetry/

# tModLoader / IDE local state
.vs/
*.user
*.csproj.user

# macOS
.DS_Store

# Agent worktrees
.claude/worktrees/

# Session run logs dropped here by the agent harness, not by the mod; tens of
# megabytes each, so an accidental `git add -A` would push one to a public repo
runs/

# The one exception, and it needs both lines: the pattern above has no leading slash, so
# git matches a directory named `runs` at every depth, and the ledger's committed run files
# sat under it silently — `git add` reported nothing and said nothing, which is the failure
# mode a gitignored ledger was refused for in the first place. A parent directory that is
# excluded cannot have its contents re-included, so the directory is un-ignored first and
# its contents second.
!Tools/Ledger/runs/
!Tools/Ledger/runs/**

# Decompiled game source written by Tools/decompile.sh; regenerated on demand from the
# installed tModLoader.dll, so committing a copy would drift from whatever version is
# actually installed
Tools/Decompiled/
